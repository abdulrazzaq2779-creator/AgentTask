# --- LLM (required for Stage 2+) ---
# Groq via the OpenAI-compatible endpoint. Free key: https://console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- Legacy Stage 1 vars (still accepted) ---
# Used only if LLM_API_KEY is not set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Hindsight Cloud (recommended) ---
# Sign up at https://hindsight.vectorize.io and paste your API key here.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=failureloop

# --- Local options ---
# SQLite database file (incidents, recommendations, feedback, fix outcomes).
FAILURELOOP_DB=failureloop.db
# API port for the React frontend backend.
API_PORT=8000
# React dev server URL (CORS).
FRONTEND_ORIGIN=http://localhost:5173
# If Hindsight is unreachable/unconfigured, fall back to a local keyword
# memory so the demo still works end-to-end. Set to 0 to disable.
FAILURELOOP_LOCAL_FALLBACK=1
